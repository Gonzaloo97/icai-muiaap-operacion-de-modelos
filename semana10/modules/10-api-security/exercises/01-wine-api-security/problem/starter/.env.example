# Predictor: ready o unavailable.
WINE_API_MODE=ready

# Clientes, claves de ejemplo, permisos y peticiones permitidas por minuto.
WINE_API_CLIENTS='{"front":{"key":"cambia-clave-front","scopes":["predict"],"rate_limit_per_minute":60},"ops":{"key":"cambia-clave-ops","scopes":["predict","admin"],"rate_limit_per_minute":60}}'

# Orígenes del navegador autorizados.
WINE_API_CORS_ORIGINS='["http://localhost:8501"]'

# Activa o desactiva docs, redoc y openapi.json.
WINE_API_DOCS_ENABLED=true
