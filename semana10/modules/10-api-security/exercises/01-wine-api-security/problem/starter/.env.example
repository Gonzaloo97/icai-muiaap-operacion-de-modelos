# Configuración de la Wine Quality API (S10).
# Copia este archivo a `.env` y sustituye cada clave de ejemplo por una
# aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Predictor: `ready` o `unavailable` (simula un modelo no cargado).
WINE_API_MODE=ready

