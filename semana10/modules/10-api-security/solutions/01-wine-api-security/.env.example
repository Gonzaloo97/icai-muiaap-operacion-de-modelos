# Configuración de la Wine Quality API (S10).
# Copia este archivo a `.env` y sustituye cada clave `cambia-...` por una
# aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Predictor: `ready` o `unavailable` (simula un modelo no cargado).
WINE_API_MODE=ready

# Clientes en JSON: nombre -> clave, scopes (`predict`, `admin`) y cuota/minuto.
# Sin clientes, todo endpoint protegido responde 401 (fail closed).
WINE_API_CLIENTS='{"front": {"key": "cambia-esta-clave-front", "scopes": ["predict"], "rate_limit_per_minute": 60}, "ops": {"key": "cambia-esta-clave-ops", "scopes": ["predict", "admin"], "rate_limit_per_minute": 30}}'

# Orígenes de navegador que pueden leer la API (JSON). Nunca "*".
WINE_API_CORS_ORIGINS='["http://localhost:8501"]'

# `false` desactiva /docs, /redoc y /openapi.json (por ejemplo, en producción).
WINE_API_DOCS_ENABLED=true
