{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Códigos estables: el cliente programa contra ellos, no contra el texto.",
        "enum": [
          "invalid_json",
          "validation_error",
          "not_found",
          "method_not_allowed",
          "http_error",
          "model_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Descripción estable del error.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo presente en errores de validación.",
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Sobre común de todas las respuestas de error.",
        "examples": [
          {
            "error": {
              "code": "validation_error",
              "fields": [
                {
                  "field": "features.alcohol",
                  "message": "Input should be a valid number"
                }
              ],
              "message": "JSON is valid but violates the input contract"
            },
            "request_id": "req_3f9a1c2b7d4e"
          }
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "Un campo del cuerpo que incumple el contrato.",
        "properties": {
          "field": {
            "examples": [
              "features.alcohol"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be a valid number"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y del modelo cargado.",
        "properties": {
          "model_status": {
            "const": "ready",
            "title": "Model Status",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "model_status",
          "model_version",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Prediction": {
        "description": "Predicción pública: no incluye puntuaciones internas del modelo.",
        "properties": {
          "confidence": {
            "description": "Confianza entre 0 y 1, con dos decimales.",
            "title": "Confidence",
            "type": "number"
          },
          "model_version": {
            "description": "Versión del artefacto que ha inferido.",
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "preprocessing_version": {
            "description": "Versión del preprocesado aplicado.",
            "minLength": 1,
            "title": "Preprocessing Version",
            "type": "string"
          },
          "quality_band": {
            "$ref": "#/components/schemas/QualityBand",
            "description": "Banda de calidad estimada."
          }
        },
        "required": [
          "quality_band",
          "confidence",
          "model_version",
          "preprocessing_version"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "description": "Cuerpo de `POST /v1/predictions`.",
        "examples": [
          {
            "features": {
              "alcohol": 9.4,
              "chlorides": 0.076,
              "citric_acid": 0.0,
              "density": 0.9978,
              "fixed_acidity": 7.4,
              "free_sulfur_dioxide": 11.0,
              "ph": 3.51,
              "residual_sugar": 1.9,
              "sulphates": 0.56,
              "total_sulfur_dioxide": 34.0,
              "volatile_acidity": 0.7
            }
          }
        ],
        "properties": {
          "features": {
            "$ref": "#/components/schemas/WineFeatures",
            "description": "Variables del vino a evaluar."
          }
        },
        "required": [
          "features"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Respuesta de `POST /v1/predictions`.",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "request_id": {
            "description": "Identificador para correlacionar logs.",
            "title": "Request Id",
            "type": "string"
          },
          "served_at": {
            "description": "Instante UTC en ISO 8601 con sufijo Z.",
            "title": "Served At",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "request_id",
          "served_at"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "QualityBand": {
        "description": "Bandas de calidad que entiende el consumidor.",
        "enum": [
          "needs_review",
          "acceptable",
          "excellent"
        ],
        "title": "QualityBand",
        "type": "string"
      },
      "WineFeatures": {
        "additionalProperties": false,
        "description": "Once variables fisicoquímicas de un vino tinto, con rangos inclusivos.",
        "properties": {
          "alcohol": {
            "description": "Alcohol (% vol.).",
            "maximum": 20.0,
            "minimum": 5.0,
            "title": "Alcohol",
            "type": "number"
          },
          "chlorides": {
            "description": "Cloruros (g/dm³).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Chlorides",
            "type": "number"
          },
          "citric_acid": {
            "description": "Ácido cítrico (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Citric Acid",
            "type": "number"
          },
          "density": {
            "description": "Densidad (g/cm³).",
            "maximum": 1.01,
            "minimum": 0.98,
            "title": "Density",
            "type": "number"
          },
          "fixed_acidity": {
            "description": "Acidez fija (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Fixed Acidity",
            "type": "number"
          },
          "free_sulfur_dioxide": {
            "description": "Dióxido de azufre libre (mg/dm³).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Free Sulfur Dioxide",
            "type": "number"
          },
          "ph": {
            "description": "pH.",
            "maximum": 4.5,
            "minimum": 2.5,
            "title": "Ph",
            "type": "number"
          },
          "residual_sugar": {
            "description": "Azúcar residual (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Residual Sugar",
            "type": "number"
          },
          "sulphates": {
            "description": "Sulfatos (g/dm³).",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Sulphates",
            "type": "number"
          },
          "total_sulfur_dioxide": {
            "description": "Dióxido de azufre total (mg/dm³).",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Total Sulfur Dioxide",
            "type": "number"
          },
          "volatile_acidity": {
            "description": "Acidez volátil (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Volatile Acidity",
            "type": "number"
          }
        },
        "required": [
          "fixed_acidity",
          "volatile_acidity",
          "citric_acid",
          "residual_sugar",
          "chlorides",
          "free_sulfur_dioxide",
          "total_sulfur_dioxide",
          "density",
          "ph",
          "sulphates",
          "alcohol"
        ],
        "title": "WineFeatures",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nServicio de inferencia del proyecto **Wine Quality** de Operación de Modelos.\n\n- Todas las respuestas incluyen `request_id` y la cabecera `X-Request-Id`.\n- Todos los errores comparten el sobre `ErrorResponse`; programa contra\n  `error.code`, no contra `error.message`.\n- La predicción es determinista y docente: no es una garantía de calidad.\n",
    "summary": "Predicción de la banda de calidad de vinos tintos.",
    "title": "Wine Quality API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Devuelve el estado del servicio y la versión del modelo cargado.\n\nÚsalo como *readiness probe*: un `200` significa que `POST /v1/predictions`\npuede responder; un `503` con `model_unavailable`, que el artefacto no está\ndisponible y el cliente debe reintentar más tarde.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "El servicio y el modelo están listos."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está cargado."
          }
        },
        "summary": "Comprobar que el servicio puede predecir",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "description": "Estima la banda de calidad a partir de once variables fisicoquímicas.\n\n- Todos los campos son obligatorios y numéricos; no se aceptan booleanos,\n  textos ni campos extra.\n- Los rangos son inclusivos y están en el esquema `WineFeatures`.\n- `confidence` se devuelve con dos decimales.\n- Guarda `request_id` si necesitas reportar una incidencia.",
        "operationId": "create_prediction_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "out_of_range": {
                  "description": "`ph` supera 4.5: devuelve `422`.",
                  "summary": "Fuera de rango",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 7.0,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "valid": {
                  "description": "Devuelve `200` con la predicción.",
                  "summary": "Vino válido",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "wrong_type": {
                  "description": "`alcohol` es un texto: devuelve `422`.",
                  "summary": "Tipo incorrecto",
                  "value": {
                    "features": {
                      "alcohol": "mucho",
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Predicción con versión del modelo y `request_id`."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El cuerpo no es JSON válido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON válido que incumple campos, tipos o rangos."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está cargado."
          }
        },
        "summary": "Predecir la banda de calidad de un vino",
        "tags": [
          "predictions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Disponibilidad del servicio y del modelo.",
      "name": "health"
    },
    {
      "description": "Inferencia de calidad de vino tinto.",
      "name": "predictions"
    }
  ]
}
